#include<iostream>
using namespace std;

int main(){
    int n;
    cout<<"enter the number: "<<endl;
    cin>>n;
    bool isprime=true;
    for(int i=2;i<n/2;i++){
        if(n%i==0){
            isprime=false;
            break;
        }
        else{
            isprime=true;
        }
    }
    if(isprime){
        cout<<"the given number is prime number :"<<endl;
    }
    else{
         cout<<"the given number is not prime number :"<<endl;
    }
    
    return 0;
}